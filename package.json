{
  "name": "alcohol-label-verifier",
  "private": true,
  "version": "1.0.0",
  "description": "Prototype that checks alcohol beverage label images against application data, entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/check-node.mjs && node scripts/copy-ocr-runtime.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-node.mjs && node scripts/copy-ocr-runtime.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/check-node.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "samples": "node tools/sample-labels/generate.mjs",
    "eval": "tsx tools/eval/run-eval.ts",
    "test:e2e": "node tests/e2e/run-e2e.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "onnxruntime-web": "^1.30.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@types/node": "^22.20.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
